<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="hypo"
        Arguments=""
        InstallLocation="C:\Program Files\Hypo Project\Hypo">
    </Installer>
    <PackageInformation
        PackageName="Hypo"
        PackageDisplayName="Hypo"
        PublisherName="CN=Hypo Project"
        PublisherDisplayName="Hypo Project"
        Version="0.1.0.0"
        PackageDescription="Open-source Windows maintenance GUI powered by the Mole CLI engine">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.hypo.app"
                Description="Open-source Windows maintenance GUI powered by the Mole CLI engine"
                DisplayName="Hypo"
                ExecutableName="hypo"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Hypo</DisplayName>
            <PublisherDisplayName>Hypo Project</PublisherDisplayName>
            <Description>Open-source Windows maintenance GUI powered by the Mole CLI engine</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="hypo.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
